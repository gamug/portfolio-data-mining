# Copy this file to .env and fill in your values. One .env, read by every
# module (each apps/*_api.py calls load_dotenv() itself, so you can also run
# any single module standalone with the same file).

# --- shared pipeline DB (news_collector, news_crawler/extractor) --------
# Where the discovered_urls -> articles chain lives. Currently just a
# filesystem path (this is still SQLite) -- kept as an env var, not
# hardcoded, so pointing it at a real connection string later (e.g. a
# hosted Postgres/libSQL DSN, if/when that migration happens) is a
# one-line env change, not a code change across the modules that share it.
# Defaults to "data/urls.db" (repo-root-relative) if unset.
DATABASE_URL=

# --- pricing (apps/pricing_api.py) --------------------------------------
# Finnhub API key (free tier is enough — get one at https://finnhub.io/register).
# NOTE: the app reads FINNHUB_API_KEY (correct spelling, two N's).
FINNHUB_API_KEY=your_finnhub_api_key_here

# --- sec_edgar (apps/sec_edgar_api.py) -----------------------------------
# SEC EDGAR requires a real identity string (name + email) for programmatic access.
NAME=Your Name
EMAIL=your.email@example.com

# --- news_collector (apps/news_collector_api.py) -------------------------
# Default discovery date range (optional — both inclusive, format YYYY-MM-DD).
# Falls back to 2022-01-01 / today if unset.
DISCOVERY_START_DATE=
DISCOVERY_END_DATE=

# SeekingAlpha official RapidAPI key (optional — enables direct API access
# instead of scraping). Get it at:
# https://rapidapi.com/seeking-alpha-seeking-alpha-default/api/seeking-alpha
SEEKINGALPHA_RAPIDAPI_KEY=

# Proxy settings (optional — helps with Cloudflare-protected domains)
# HTTP_PROXY=http://user:pass@proxyhost:8080
# HTTPS_PROXY=http://user:pass@proxyhost:8080
