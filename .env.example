# Copy this file to .env and fill in your values. One .env, read by every
# entry point (apps/*.py, cli/*.py, python -m news_collector.main) through
# data_mining.env.load_env(), so you can run any single one standalone.
#
# A non-empty value here WINS over the same variable inherited from the system or the
# shell (T-066b). A blank value (`NAME=`) or a missing line leaves the inherited one as it
# is, so a blank line cannot switch off an inherited HTTP_PROXY/HTTPS_PROXY. A one-off
# `DATABASE_URL=... uv run ...` on the command line loses to this file: edit it instead,
# or pass a flag (--db, --allow-new-db). Each override is logged (values only for
# DATABASE_URL, UNIVERSE_DB_PATH and the dates) on the console when the process starts and again,
# as `.env override: …`, in the collector's `.log/` file trace once that exists.

# --- shared pipeline DB (news_collector, news_crawler/extractor) --------
# Where the discovered_urls -> articles chain lives. Currently just a
# filesystem path (this is still SQLite) -- kept as an env var, not
# hardcoded, so pointing it at a real connection string later (e.g. a
# hosted Postgres/libSQL DSN, if/when that migration happens) is a
# one-line env change, not a code change across the modules that share it.
# Defaults to "data/urls.db" (repo-root-relative) if unset or empty.
DATABASE_URL=
# Set to 1 to let the gateway and the crawler start on a database with no discovered_urls rows
# (they refuse by default, T-066a). Unset by default; `--allow-new-db` does the same.
# ALLOW_NEW_DB=1

# --- pricing (apps/pricing_api.py) --------------------------------------
# Finnhub API key (free tier is enough — get one at https://finnhub.io/register).
# NOTE: the app reads FINNHUB_API_KEY (correct spelling, two N's).
FINNHUB_API_KEY=your_finnhub_api_key_here

# Point-in-time S&P 500 membership store (src/common/universe_history.py),
# separate from the news-pipeline DATABASE_URL above -- pricing/sec_edgar
# still don't touch that one. Optional; defaults to "data/universe.db"
# (repo-root-relative) if unset. Populated by running
# `cli/pricing_cli.py universe-backfill` once.
UNIVERSE_DB_PATH=

# --- sec_edgar (apps/sec_edgar_api.py) + universe-gics ---------------------
# SEC EDGAR requires a real identity string (name + email) for programmatic access.
# `cli/pricing_cli.py universe-gics` sends the same identity to Wikimedia's API and
# refuses to run while these are unset or still the placeholders below.
NAME=Your Name
EMAIL=your.email@example.com

# --- leaver-prices (cli/pricing_cli.py leaver-prices) ----------------------
# Tiingo API key, used only by the one-off, private leaver-prices build step
# (never by a service). It is deliberately NOT written here: set it in the
# shell only, so the key never lands in .env or in git:
#   read -rs TIINGO_API_KEY && export TIINGO_API_KEY
# The key is read from $TIINGO_API_KEY and sent only in the Authorization header.
# TIINGO_API_KEY=

# --- news_collector (apps/news_collector_api.py) -------------------------
# Default discovery start date (optional — inclusive, format YYYY-MM-DD).
# Falls back to 2022-01-01 if unset.
# The end date is not a variable: pass --end-date (CLI) or end_date (API); it defaults to
# today, UTC. A DISCOVERY_END_DATE line is ignored and logged once (T-077).
DISCOVERY_START_DATE=

# SeekingAlpha official RapidAPI key (optional — enables direct API access
# instead of scraping). Get it at:
# https://rapidapi.com/seeking-alpha-seeking-alpha-default/api/seeking-alpha
SEEKINGALPHA_RAPIDAPI_KEY=

# Proxy settings (optional — helps with Cloudflare-protected domains)
# HTTP_PROXY=http://user:pass@proxyhost:8080
# HTTPS_PROXY=http://user:pass@proxyhost:8080
