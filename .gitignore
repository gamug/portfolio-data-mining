# --- Environments -----------------------------------------------------
.env
.venv/
venv/
env/
.venv-stale-windows-do-not-use/

# --- Byte-compiled / caches --------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.hypothesis/
.mypy_cache/
.ruff_cache/

# --- Runtime data & generated output (per-module, all regenerated on demand) --
# Shared pipeline SQLite DB written by news_collector -> extractor -> news_nlp.
data/urls.db
data/*.db-*
data/urls.db.bak-*
# Point-in-time S&P 500 membership store (src/common/universe_history.py).
data/universe.db
# finhub-derived output/input scratch dirs -- nothing currently creates or
# writes into these (the init_repository()/check_repository() machinery
# that used to was removed as dead code), kept ignored defensively in case
# something drops files here by hand.
output/
input/
# news-nlp: models are fetched into the local HF cache by `python -m
# news_nlp.setup`, never vendored into the repo (multi-GB checkpoints).
models/
*.log
pipeline_run.log
train_ner.log

# --- Editors / tool-local state (kept per-module upstream, not shared here) --
.vscode/
.idea/
.kiro/
.log/

# Claude Code / agent tool artifacts (kept local, not version-controlled).
# .specify/ is the exception: it holds the spec-kit constitution/specs this
# project deliberately versions as its source of truth, not a tool scratch
# dir, so it stays tracked.
CLAUDE.md
.claude/
.superpowers/
docs/superpowers/
