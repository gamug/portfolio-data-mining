# --- Environments -----------------------------------------------------
.env
.venv/
venv/
env/

# --- Byte-compiled / caches --------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.hypothesis/
.mypy_cache/
.ruff_cache/

# --- Runtime data & generated output (per-module, all regenerated on demand) --
# Shared pipeline SQLite DB written by news_collector -> extractor -> news_nlp.
data/urls.db
data/*.db-*
data/urls.db.bak-*
# finhub-derived output/input scratch dirs (seeded/populated at runtime by
# common.utils.init_repository()).
output/
input/
# news-nlp: models are fetched into the local HF cache by `python -m
# news_nlp.setup`, never vendored into the repo (multi-GB checkpoints).
models/
*.log
pipeline_run.log
train_ner.log

# --- Editors / tool-local state (kept per-module upstream, not shared here) --
.vscode/
.idea/
.kiro/
.claude/settings.local.json
.claude/scheduled_tasks.lock
.log/
